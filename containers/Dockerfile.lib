# One image for the sim, api and admin services; docker-compose.yml sets each one's command and healthcheck.

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /usr/local/bin/uv

WORKDIR /app

ENV UV_PYTHON_PREFERENCE=only-system \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY sim-ops-ng-lib/pyproject.toml sim-ops-ng-lib/uv.lock ./

RUN uv sync --frozen --no-install-project --no-dev

# skyfield would otherwise download the ephemeris from JPL on every fresh container
RUN mkdir /ephemeris && .venv/bin/python -c \
    "from skyfield.api import Loader; Loader('/ephemeris')('de421.bsp')"


FROM python:3.12-slim

RUN useradd --system --uid 1000 --no-create-home --home-dir /app simops

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

COPY sim-ops-ng-lib/ .
COPY --from=builder /ephemeris/de421.bsp /app/de421.bsp

USER simops

# sim socket, API, admin
EXPOSE 5555 9111 9131

CMD ["/app/.venv/bin/python", "bin/sim-ops.py"]

# build stage
FROM node:24 AS build-stage

# Cesium Ion token from the root .env via docker-compose; Vite reads it from the process env (no .env in context)
ARG VITE_CESIUM_TOKEN
ENV VITE_CESIUM_TOKEN=${VITE_CESIUM_TOKEN}

WORKDIR /app
COPY sim-ops-ng-3dv/package*.json ./
RUN npm ci
COPY sim-ops-ng-3dv/ .
# vite-plugin-cesium copies assets into dist/3dv/cesium/, but nginx strips /3dv/, so copy them where expected
RUN npm run build && cp -r dist/3dv/cesium dist/cesium

# production stage: runs as the unprivileged nginx user, listening on 8080
FROM nginxinc/nginx-unprivileged:stable-alpine AS production-stage
COPY --from=build-stage /app/dist /usr/share/nginx/html
COPY containers/nginx/3dv.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/ || exit 1

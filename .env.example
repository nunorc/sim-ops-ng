# =============================================================================
# Sim-Ops NG — environment configuration template
#
# Copy this file to `.env` and fill in the secrets:
#     cp .env.example .env
#
# This is the single source of truth for the whole repo. `docker compose` reads
# it automatically, and the manual dev flows read it too: the Python apps via
# `load_dotenv()` (which walks up to here) and the Vite frontends via `envDir`
# pointing at the repo root. There are NO per-sub-project .env files.
#
# The values below are for MANUAL DEV (everything on localhost). Docker compose
# fixes the container networking itself (hosts, ports, MinIO endpoint, API URL),
# so the "networking" settings marked below are ignored there; the secrets and
# other settings apply to both. If `.env` is absent, compose uses the same
# defaults (via ${VAR:-default}).
# =============================================================================

# --- Object store (MinIO) ----------------------------------------------------
# Change these: the MinIO console (http://localhost:9001, published on localhost only) accepts them.
SIM_OPS_NG_MINIO_ROOT_USER=myusername
SIM_OPS_NG_MINIO_ROOT_PASSWORD=mypassword
# networking (manual dev only). Without a MinIO there the sim runs without storing packets.
SIM_OPS_NG_MINIO_ENDPOINT=localhost:9000

# --- Authentication ----------------------------------------------------------
SIM_OPS_NG_ADMIN_PASSWORD=admin123
SIM_OPS_NG_USER_PASSWORD=user123
# Admin session cookie secret (empty: random per start); python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Simulation engine (sim-ops-ng-sim) --------------------------------------
SIM_OPS_NG_SCENARIO=data/demo.json
# networking (manual dev only): the sim binds here and the API connects here
SIM_OPS_NG_SOCKET_HOST=127.0.0.1
SIM_OPS_NG_SOCKET_PORT=5555

# --- REST/WebSocket API (sim-ops-ng-api) -------------------------------------
# networking (manual dev only)
SIM_OPS_NG_API_HOST=0.0.0.0
SIM_OPS_NG_API_PORT=9111
# URL the admin app uses to reach the API
SIM_OPS_NG_API_URL=http://localhost:9111

# --- Admin control panel (sim-ops-ng-admin) ----------------------------------
# networking (manual dev only)
SIM_OPS_NG_ADMIN_HOST=0.0.0.0
SIM_OPS_NG_ADMIN_PORT=9131
SIM_OPS_NG_ADMIN_WORKERS=4

# --- 3D visualization (sim-ops-ng-3dv) — build time --------------------------
# Cesium Ion token, baked into the 3dv bundle at image build; get a free one at https://cesium.com/ion/tokens
VITE_CESIUM_TOKEN=

# --- MCS UI (sim-ops-ng-mcs) — local dev only --------------------------------
# Read by `npm run dev` (Vite envDir=".."); the docker (nginx) build forces these empty for relative proxy paths.
# VITE_SO_API=http://localhost:9111
# VITE_WS_URL=ws://localhost:9111/api/ws

# --- bin/ws-client.py (debug WebSocket listener) — local dev only -----------
# SIM_OPS_NG_BACKEND_WS=ws://localhost:9111/api/ws
